{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Dev Studio",
  "version": "0.1.0",
  "identifier": "com.localdevstudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Dev Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "binaries/*"
    ]
  }
}
