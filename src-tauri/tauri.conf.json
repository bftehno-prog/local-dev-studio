{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Dev Studio",
  "version": "0.1.0",
  "identifier": "com.localdevstudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Dev Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://localhost:* http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "frame-src": "http://localhost:* http://127.0.0.1:*"
      }
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["binaries/*"]
  }
}
